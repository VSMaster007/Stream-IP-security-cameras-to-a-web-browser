# Copy to .env and edit locally. Never commit .env or real camera credentials.

# demo publishes an FFmpeg test pattern. rtsp pulls one configured camera.
STREAM_SOURCE_MODE=demo

# Stable identifier for the single configured camera. The MediaMTX path uses this value.
CAMERA_ID=cam1
CAMERA_NAME=Demo Camera

# Required only when STREAM_SOURCE_MODE=rtsp.
# Example shape: rtsp://USERNAME:PASSWORD@CAMERA_HOST:554/STREAM_PATH
RTSP_URL=

# Backend process. Bind to loopback for local development.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001
NODE_ENV=development

# Browser origin allowed to call the backend.
CORS_ORIGIN=http://127.0.0.1:5173

# MediaMTX Control API. Inside Docker Compose this is http://mediamtx:9997.
# Do not publish this port on the host.
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_API_TIMEOUT_MS=2000

# Browser-facing WHEP endpoint. The video path is delivered by MediaMTX, not the backend.
WHEP_URL=http://127.0.0.1:8889/cam1/whep

# Host or IP that browsers use to reach MediaMTX ICE. Use a LAN address for remote clients.
WEBRTC_ADDITIONAL_HOSTS=127.0.0.1

# Baked into the frontend bundle at build time. This is a public URL, not a secret.
VITE_API_BASE_URL=http://127.0.0.1:3001
